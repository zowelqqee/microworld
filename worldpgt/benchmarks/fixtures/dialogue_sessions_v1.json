{
  "version": "1",
  "description": "Deterministic dialogue-context benchmark: scripted sessions asserted against resolver traces (bindings, outcomes, margins, exact integer scores, topic). False resolution = build failure; justified audit never is.",
  "sessions": [
    {
      "id": "canonical_spacex_flow",
      "description": "The six-turn flow from the design brief: pronouns, exclusion, topic shift, typed demonstrative.",
      "world": {
        "entities": {"SpaceX": "organization", "Blue Origin": "organization", "Tesla": "organization", "Starlink": "organization", "Neuralink": "organization", "PayPal": "organization", "Elon Musk": "person", "Jeff Bezos": "person", "Falcon 9": "vehicle"},
        "surfaces": {"Musk": "Elon Musk", "Bezos": "Jeff Bezos"},
        "facts": [
          ["SpaceX", "founded_by", "Elon Musk"],
          ["Tesla", "founded_by", "Elon Musk"],
          ["Neuralink", "founded_by", "Elon Musk"],
          ["PayPal", "founded_by", "Elon Musk"],
          ["Starlink", "founded_by", "Elon Musk"],
          ["Blue Origin", "founded_by", "Jeff Bezos"],
          ["SpaceX", "develops", "Falcon 9"],
          ["Blue Origin", "develops", "New Shepard"],
          ["Starlink", "owned_by", "SpaceX"],
          ["Starlink", "develops", "satellite internet"]
        ]
      },
      "turns": [
        {"q": "Tell me about SpaceX.", "expect": {"outcome": "no_slots", "topic_after": "SpaceX", "decision": "answer"}},
        {"q": "What does it build?", "expect": {"outcome": "resolved", "bindings": {"it": ["SpaceX"]}, "top_scores": {"SpaceX": 191}, "decision": "answer"}},
        {"q": "Who founded it?", "expect": {"outcome": "resolved", "bindings": {"it": ["SpaceX"]}, "top_scores": {"SpaceX": 204}, "margin_min": 25, "decision": "answer"}},
        {"q": "What else did he found?", "expect": {"outcome": "resolved", "bindings": {"he": ["Elon Musk"]}, "exclude": ["SpaceX"], "decision": "answer"}},
        {"q": "What about Starlink?", "expect": {"outcome": "resolved", "topic_after": "Starlink", "answer_style": "followup", "decision": "answer"}},
        {"q": "What does that company develop?", "expect": {"outcome": "resolved", "bindings": {"that company": ["Starlink"]}, "top_scores": {"Starlink": 194, "SpaceX": 13}, "margin_min": 25, "decision": "answer"}}
      ]
    },
    {
      "id": "topic_shift_then_pronoun",
